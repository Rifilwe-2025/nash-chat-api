# Copy to .env and adjust. Every key here overrides the matching default in
# src/configs/application.yaml, which stays the source of truth for shape and defaults.

# Application
APP_NAME=Nash Chat API
APP_ENV=local
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database — PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/nashdb
# The test suite drops and recreates this database on every run — never point it at the app database.
DATABASE_TEST_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/nashdb_test
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM providers — set the keys for the providers you intend to offer
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=8
# Provider to use when the configured one is rate limited or down. Empty disables fallback.
LLM_FALLBACK_PROVIDER=
# Per-model prices for cost recording, USD per million tokens. Empty means tokens are recorded
# but cost is not — the platform never guesses at pricing.
# Example: LLM_PRICE_TABLE=gpt-4o=2.5/10,claude-sonnet-4-5=3/15
LLM_PRICE_TABLE=

# Conversation engine
CONVERSATION_HISTORY_BUDGET_FRACTION=0.5
CONVERSATION_SUMMARY_MAX_TOKENS=512
CONVERSATION_MAX_MESSAGE_CHARACTERS=8000

# Knowledge base ingestion — sizes in bytes (10 MB per source, 250 MB per tenant)
KB_MAX_SOURCE_BYTES=10485760
KB_MAX_TENANT_BYTES=262144000
KB_URL_FETCH_TIMEOUT_SECONDS=20
# Leave false anywhere reachable from outside: it is what stops a submitted URL reaching
# internal services (SSRF).
KB_ALLOW_PRIVATE_URLS=false
# Which model reads PDFs and images natively, in place of an OCR pipeline
KB_EXTRACTION_PROVIDER=gemini
KB_EXTRACTION_MODEL=gemini-2.0-flash
KB_EXTRACTION_MAX_TOKENS=8192
# Retrieval — how much knowledge may be injected, and how keyword search ranks
KB_DIRECT_INJECTION_MAX_CHARS=48000
KB_CONTEXT_BUDGET_FRACTION=0.25
KB_KEYWORD_TOP_N=5
KB_KEYWORD_MIN_RANK=0.02

# Auth — JWT_SECRET_KEY must be a long random value in any deployed environment
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Background queue — use redis in any deployment; inline runs work in the request instead
QUEUE_MODE=inline
QUEUE_TASK_SOFT_TIME_LIMIT_SECONDS=270
QUEUE_TASK_TIME_LIMIT_SECONDS=300
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_BACKOFF_SECONDS=30

# Scheduled source sync
SYNC_DEFAULT_INTERVAL_MINUTES=0
SYNC_MIN_INTERVAL_MINUTES=15
SYNC_FAILURE_ALERT_THRESHOLD=3
SYNC_MAX_RECORDS=5000
SYNC_MAX_PAGES=50

# Security (Phase 13, spec §5.7)
# SECURITY_ENCRYPTION_KEY encrypts tenant-provided credentials at rest: WhatsApp tokens, tool API
# keys, webhook signing secrets. 32 bytes, base64. Generate one with
#   python -c "from src.shared.crypto import generate_key; print(generate_key())"
# Set it before the first credential is stored and keep it: rows written under a key cannot be read
# without it. Empty leaves those columns in clear and the API warns at startup.
SECURITY_ENCRYPTION_KEY=
SECURITY_HSTS_MAX_AGE_SECONDS=31536000

# Plan limits and usage metering (spec §5.9). BILLING_ENFORCE is off by default: pricing is still
# an open question (§9), and metering is useful long before anyone is charged. BILLING_PLANS is
# "<plan>=agents:N,messages:N,storage:BYTES", semicolons between plans, -1 for unlimited; a limit a
# plan does not name keeps its built-in default.
BILLING_PLANS=
BILLING_ENFORCE=false
BILLING_HISTORY_PERIODS=12

# Rate limiting — use redis anywhere with more than one worker
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_MAX_PER_MINUTE=6000
# Per client address, on signup/login/refresh — the endpoints reachable with no credential.
RATE_LIMIT_AUTH_PER_MINUTE=20

# Analytics reporting windows (spec §5.8)
ANALYTICS_DEFAULT_WINDOW_DAYS=30
ANALYTICS_MAX_WINDOW_DAYS=366

# Observability. OBSERVABILITY_OPERATOR_TOKEN opens GET /analytics/operations, which reports this
# process's counters across every tenant. Empty leaves that endpoint closed.
OBSERVABILITY_OPERATOR_TOKEN=

# Outbound webhooks
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_SIGNATURE_HEADER=X-Nash-Signature

# Agent tools — Pattern A live API calls (spec §5.2.1). A customer waits on every one of these,
# so the timeout is short and the retry budget is one. Per-tool credentials and the per-agent
# endpoint allowlist live in the database, not here.
TOOLS_TIMEOUT_SECONDS=8
TOOLS_MAX_RETRIES=1
TOOLS_MAX_CALLS_PER_TURN=3
TOOLS_MAX_RESULT_CHARACTERS=4000
TOOLS_USER_AGENT=NashChatBot/1.0 (+agent-tools)
# Leave false outside local development: a tool endpoint is called with model-written arguments.
TOOLS_ALLOW_PRIVATE_URLS=false

# WhatsApp channel — per-tenant credentials are stored on the connection, not here.
# WHATSAPP_PUBLIC_BASE_URL must be the origin Meta can reach: behind a proxy the request's own
# origin is the internal one, and a tenant pasting that into Meta gets a callback that never
# verifies. Leave it empty locally and the request's origin is used.
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_REQUEST_TIMEOUT_SECONDS=15
WHATSAPP_SESSION_WINDOW_HOURS=24
WHATSAPP_MAX_MEDIA_BYTES=16777216
WHATSAPP_PUBLIC_BASE_URL=

# API documentation (Swagger UI / ReDoc / OpenAPI schema)
DOCS_ENABLED=true
DOCS_SWAGGER_PATH=/docs
DOCS_REDOC_PATH=/redoc
DOCS_OPENAPI_PATH=/openapi.json

# Logging
LOG_LEVEL=INFO

# CORS — comma-separated
CORS_ALLOW_ORIGINS=http://localhost:3000
